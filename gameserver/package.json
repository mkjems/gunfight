{
    "name": "gunfight-server",
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
        "start": "node server.js",
        "dev": "node server.js",
        "format": "prettier --write --config ../.prettierrc.json --ignore-path ../.prettierignore --ignore-unknown . ../www ../compose.yaml ../.github/workflows/container.yml ../documentation/TODO.md ../documentation/State-ownership.md",
        "format:check": "prettier --check --config ../.prettierrc.json --ignore-path ../.prettierignore --ignore-unknown . ../www ../compose.yaml ../.github/workflows/container.yml ../documentation/TODO.md ../documentation/State-ownership.md",
        "lint": "eslint --config ../.eslintrc.cjs . ../www/js",
        "typecheck": "tsc --project tsconfig.json",
        "test": "node --test test/*.test.js"
    },
    "dependencies": {
        "express": "^5.1.0",
        "socket.io": "^4.8.1"
    },
    "devDependencies": {
        "eslint": "^8.57.1",
        "prettier": "^3.3.3",
        "typescript": "^5.5.4"
    }
}
